# Copy to .env next to docker-compose.yml and adjust.

# ---- Database ----
# Option A: use the bundled postgres service (default). Just set a password:
DB_PASS=chl

# Option B: use your existing host PostgreSQL instead of the bundled db service.
# (comment out the `db` service in docker-compose.yml, then set:)
# DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/chl?sslmode=disable

# ---- App ----
JWT_SECRET=please-change-this-to-a-long-random-string
# 平台对外地址（用于收银台回调跳转 success/cancel_url）。填你的域名或服务器 IP。
# 对外 HTTP/HTTPS 由宿主机 nginx 负责（见 deploy/nginx/chl.conf），这里无需配置域名。
PUBLIC_BASE_URL=http://your-server-ip

# ---- UPay（v0.0.2 真实支付；留空则为占位模式，本地无 NetBird 也能跑）----
# 全部填上才启用真实支付。需 VDS 能经 NetBird 访问 api.upay.local。
# UPAY_BASE_URL=https://api.upay.local
# UPAY_API_KEY=sk_test_<key_id>.<secret>          # scope: payments:read + payments:write
# UPAY_WEBHOOK_SECRET=whsec_xxx                    # 商户后台配置回调端点时获取；轮换期可逗号分隔两个
# UPAY_CA_CERT=/app/upay-local-ca.crt             # compose 已挂载 certs/upay-local-ca.crt 到此路径
# RECONCILE_INTERVAL=60s                           # 兜底轮询周期
#
# 回调地址（在 UPay 商户后台登记）：https://你的域名/api/webhooks/upay
