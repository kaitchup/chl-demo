# chl-demo 部署环境变量模板
# 复制为 .env 并填入真实值，不要提交 .env 到 git

# 数据库（自带 postgres 容器，默认用这些；换成宿主机 DB 则改 DATABASE_URL）
DB_PASS=change-me-strong-random-hex
DATABASE_URL=postgres://chl:change-me-strong-random-hex@db:5432/chl?sslmode=disable

# JWT
JWT_SECRET=change-me-strong-random-base64
JWT_TTL=24h

# 对外 URL（影响 UPay success_url 回跳）
PUBLIC_BASE_URL=https://kaitchup.fun

# UPay 测试环境（留空 = 占位模式）
UPAY_BASE_URL=http://api.upay-test.com
UPAY_API_KEY=sk_test_...
UPAY_WEBHOOK_SECRET=whsec_...
UPAY_CA_CERT=

# 对账轮询间隔（默认 60s，测试用 30s）
RECONCILE_INTERVAL=30s

# 第三方商家 Webhook 签名密钥（可选，用于测试/集成 webhook 回调）
# YOKI_WEBHOOK_SECRET=
# SUDY_WEBHOOK_SECRET=
# SHIRLY_WEBHOOK_SECRET=
# TIA_WEBHOOK_SECRET=
# CASSIEL_WEBHOOK_SECRET=

# Sandbox 沙盒模拟模块（留空 = 禁用，返回 503）
# Dolos 是专用管理员账户，用于代商户调用 admin BFF 的模拟/AML 接口
DOLOS_EMAIL=admin@upay.local
DOLOS_PASSWORD=
ADMIN_BASE_URL=https://admin.upay-test.com/api/v1
MERCHANT_ADMIN_BASE_URL=https://merchant.upay-test.com/api/v1
SANDBOX_MAX_AML_RETRIES=20
